{
  "framework": null,
  "installCommand": "git clone --depth 1 --branch 3.38.4 https://github.com/flutter/flutter.git .flutter-sdk && .flutter-sdk/bin/flutter pub get --enforce-lockfile",
  "buildCommand": "test -n \"$BACKEND_URL\" && .flutter-sdk/bin/flutter build web --release --no-pub --dart-define=BACKEND_URL=\"$BACKEND_URL\"",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
