# ==========================================
# Variables de Entorno de Kpital (Backend)
# ==========================================

# 1. Clave de Google AI Studio (Gemini) - Gratuita en https://aistudio.google.com
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# 2. Base de Datos PostgreSQL Serverless (Neon.tech o Supabase) - Gratuita en https://neon.tech
DATABASE_URL=postgresql://usuario:password@ep-xyz.neon.tech/kpital?sslmode=require

# 3. Envío de Correos Gratuitos (Resend API) - Gratuito 3,000 emails/mes en https://resend.com
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=Kpital <onboarding@resend.dev>

# 4. Fallback SMTP (Gmail App Password - Opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# 5. WhatsApp Cloud API (Meta for Developers) - 1,000 conversaciones gratis/mes en https://developers.facebook.com
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# 6. Configuración del Servidor
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
